{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compiler CoursesHippiques",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/Build.ps1"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Lancer CoursesHippiques",
      "type": "process",
      "command": "${workspaceFolder}/src/CoursesHippiques.GUI/bin/Debug/CoursesHippiques.GUI.exe",
      "dependsOn": "Compiler CoursesHippiques",
      "problemMatcher": []
    }
  ]
}
